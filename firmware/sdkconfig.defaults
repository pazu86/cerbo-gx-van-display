CONFIG_IDF_TARGET="esp32s3"

# --- CPU / RTOS ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Flash + PSRAM at 120 MHz (Waveshare's tested config for this board) ---
# The RGB panel scans out of PSRAM continuously; at 80 MHz there isn't enough
# bandwidth left for LVGL and the bounce buffers underrun (torn/shifted lines).
# 120 MHz is "experimental" in IDF, so PSRAM timing is re-tuned against chip
# temperature every 5 s to cope with the van's temperature swings.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BOOTLOADER_FLASH_DC_AWARE=y
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_MEASURE_TEMPERATURE_INTERVAL_SECOND=5
CONFIG_SPIRAM_MEMTEST=n
# Run code/rodata from PSRAM so flash writes (NVS, OTA) don't stall the RGB DMA
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# Small mallocs (LVGL objects, MQTT, cJSON...) go to PSRAM too: internal RAM is
# reserved for the RGB bounce buffers, WiFi DMA and task stacks.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# --- RGB LCD ---
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# --- Console over native USB (the Type-C port is the S3's USB-Serial-JTAG) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- LVGL 9 ---
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# CONFIG_LV_USE_SYSMON is not set
# CONFIG_LV_USE_PERF_MONITOR is not set


# --- WiFi: keep internal RAM free ---
# The RGB bounce buffers need ~80 kB of internal RAM; WiFi defaults to static
# TX buffers and IRAM-optimised paths that leave too little and abort at init.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_RX_BA_WIN=6

# --- Map: PNG tiles over HTTPS ---
# Tiles are decoded by main/png565.c (ROM inflate, fixed buffers), not lodepng
# TLS buffers/contexts in PSRAM, not the scarce internal RAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y

# --- OTA: roll back a new firmware that doesn't confirm itself healthy ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- BLE: NimBLE central for the optional Projecta PM335 (only started when
# CONFIG_PM335_ENABLE is set; leave BT enabled either way, the component needs it) ---
# Host allocations in PSRAM and a minimal controller: internal RAM is the
# scarce resource on this board (RGB bounce buffers, WiFi DMA).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Pairing with the PM module (passkey entry); bonds kept in RAM
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_MSYS_BUF_FROM_HEAP=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# Controller code out of IRAM (~17 kB). Safe here: code executes from PSRAM
# (SPIRAM_XIP_FROM_PSRAM), so flash erases don't stall it.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_CTRL_DTM_ENABLE=n
# Large static buffers marked EXT_RAM_BSS_ATTR live in PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
